# Google Apps Script Web App URL that receives contact-form submissions.
# Deployed from apps-script/Code.gs (Deploy > New deployment > Web app,
# Execute as: Me, Who has access: Anyone).
#
# This file IS committed, so Vercel picks the value up straight from GitHub on
# every build - no dashboard configuration needed. Vite inlines VITE_* values
# into the client bundle at build time, so this URL is public either way.
#
# To point a local dev server at a different deployment, create .env.local
# (gitignored) with the same key; it takes precedence over this file.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxO6crMNiClCEmmwyIlsXQIKyoK1108V0jZjP_BrvepbFjftG2bPhzMR-erWg7BE9LV/exec
